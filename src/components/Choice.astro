---
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const insights = [1, 2, 3].map((n) => ({
  tag: t(`insights.${n}.tag` as any),
  finding: t(`insights.${n}.finding` as any),
  action: t(`insights.${n}.action` as any),
}));
---

<section id="analisis" class="py-24 bg-gray-50">
  <div class="max-w-6xl mx-auto px-5">
    <div class="text-center mb-14 animate-fade-in-up">
      <span
        class="inline-block text-[#14b81a] text-sm font-semibold uppercase tracking-widest mb-3"
        >{t("insights.badge")}</span
      ><h2 class="text-3xl sm:text-4xl font-bold text-[#082109]">
        {t("insights.title1")}
        <span class="text-[#14b81a]">{t("insights.title2")}</span>
      </h2>
      <p class="text-gray-500 text-base max-w-xl mx-auto mt-3">
        {t("insights.subtitle")}
      </p>
    </div>

    <div class="grid lg:grid-cols-3 gap-6 mb-6">
      {
        insights.map((item, i) => (
          <div
            class="bg-white border border-gray-100 rounded-3xl p-8 hover:border-[#14b81a]/30 hover:shadow-xl transition-all duration-300 animate-fade-in-up"
            style={`animation-delay: ${(i + 1) * 100}ms`}
          >
            <span class="inline-block bg-[#14b81a]/10 text-[#14b81a] text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-5">
              {item.tag}
            </span>
            <p class="text-xs font-semibold text-[#082109]/50 uppercase tracking-wider mb-1">
              {t("insights.finding")}
            </p>
            <p class="text-[#082109] text-sm leading-relaxed mb-5">
              {item.finding}
            </p>
            <div class="bg-[#14b81a]/10 rounded-2xl p-4">
              <p class="text-xs font-semibold text-[#04910a] uppercase tracking-wider mb-1">
                {t("insights.action")}
              </p>
              <p class="text-[#082109] text-sm font-medium leading-relaxed">
                {item.action}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Executive summary example -->
    <div
      class="bg-[#082109] rounded-3xl p-8 sm:p-10 text-white animate-fade-in-up"
    >
      <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <h3 class="text-xl font-bold">📊 {t("insights.report.title")}</h3>
        <span class="text-xs text-white/60 border border-white/20 rounded-full px-3 py-1">
          {t("insights.report.example")}
        </span>
      </div>
      <div class="grid sm:grid-cols-3 gap-4 mb-6">
        <div class="bg-white/5 rounded-2xl p-5">
          <p class="text-white/60 text-xs uppercase tracking-wider mb-1">
            {t("insights.report.sales")}
          </p>
          <p class="text-2xl font-bold text-[#1ec924]">$X,XXX</p>
        </div>
        <div class="bg-white/5 rounded-2xl p-5">
          <p class="text-white/60 text-xs uppercase tracking-wider mb-1">
            {t("insights.report.best")}
          </p>
          <p class="text-2xl font-bold text-[#1ec924]">
            {lang === "es" ? "Viernes · 5 PM" : "Friday · 5 PM"}
          </p>
        </div>
        <div class="bg-white/5 rounded-2xl p-5">
          <p class="text-white/60 text-xs uppercase tracking-wider mb-1">
            {t("insights.report.star")}
          </p>
          <p class="text-2xl font-bold text-[#1ec924]">
            {lang === "es" ? "[Tu producto]" : "[Your product]"}
          </p>
        </div>
      </div>
      <p class="text-white/85 text-sm leading-relaxed">
        💡 <strong>{t("insights.report.tip")}:</strong>
        {lang === "es"
          ? "la reposición subió más rápido que las ventas. Conviene comprar en dos lotes y dejar de reponer el producto que casi no rota."
          : "restock grew faster than sales. Buy in two batches and stop replenishing the product that barely moves."}
      </p>
    </div>
  </div>
</section>
