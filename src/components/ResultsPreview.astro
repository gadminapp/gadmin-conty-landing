---
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const metrics = [
  { label: t("report.sales"), value: "$12,480", delta: "+18%" },
  { label: t("report.margin"), value: "34%", delta: "+4 pts" },
  { label: t("report.restock"), value: "$2,140", delta: "−12%" },
  { label: t("report.ticket"), value: "$42", delta: "+$6" },
];
---

<div
  class="relative w-full max-w-xl rounded-3xl border border-[#082109]/10 bg-white shadow-2xl overflow-hidden"
>
  <div class="flex items-center justify-between px-5 py-4 border-b border-[#082109]/8 bg-[#082109]">
    <div>
      <p class="text-[11px] uppercase tracking-wider text-white/50 font-semibold">
        {t("report.kicker")}
      </p>
      <p class="text-white font-bold text-sm mt-0.5">{t("report.title")}</p>
    </div>
    <span class="text-[11px] font-semibold text-[#082109] bg-[#1ec924] px-2.5 py-1 rounded-full">
      {t("report.period")}
    </span>
  </div>

  <div class="grid grid-cols-2 gap-3 p-4">
    {
      metrics.map((metric) => (
        <div class="rounded-2xl bg-[#f4f7f4] p-3.5">
          <p class="text-[11px] uppercase tracking-wide text-[#082109]/50 font-semibold">
            {metric.label}
          </p>
          <p class="text-xl font-bold text-[#082109] mt-1">{metric.value}</p>
          <p class="text-xs font-semibold text-[#04910a] mt-1">{metric.delta}</p>
        </div>
      ))
    }
  </div>

  <div class="px-4 pb-4 space-y-3">
    <div class="rounded-2xl border border-[#082109]/8 p-4">
      <p class="text-[11px] uppercase tracking-wide text-[#082109]/45 font-bold mb-1">
        {t("report.finding")}
      </p>
      <p class="text-sm text-[#082109] leading-relaxed">{t("report.findingText")}</p>
    </div>
    <div class="rounded-2xl bg-[#14b81a]/10 p-4">
      <p class="text-[11px] uppercase tracking-wide text-[#04910a] font-bold mb-1">
        {t("report.action")}
      </p>
      <p class="text-sm text-[#082109] leading-relaxed">{t("report.actionText")}</p>
    </div>
    <p class="text-xs text-[#082109]/45 text-center pt-1">{t("report.note")}</p>
  </div>
</div>
