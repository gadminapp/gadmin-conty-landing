---
import ResultsPreview from "./ResultsPreview.astro";
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";
import { whatsappUrl } from "../config/contact";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const whatsappHref = whatsappUrl(t("cta.whatsappMessage"));

const steps = [
  { n: "1", title: t("how.step1.title"), desc: t("how.step1.desc") },
  { n: "2", title: t("how.step2.title"), desc: t("how.step2.desc") },
  { n: "3", title: t("how.step3.title"), desc: t("how.step3.desc") },
];
---

<section id="como-funciona" class="py-24 bg-gray-50 overflow-hidden">
  <div class="max-w-6xl mx-auto px-5">
    <div class="flex flex-col lg:flex-row items-center gap-16">
      <div class="flex-1 animate-fade-in-left">
        <div
          class="inline-flex items-center gap-2 bg-[#14b81a]/10 text-[#14b81a] text-sm font-bold px-4 py-1.5 rounded-full mb-6"
        >
          {t("how.badge")}
        </div>
        <h2
          class="text-3xl sm:text-4xl font-bold text-[#082109] mb-6 leading-tight"
        >
          {t("how.title1")}
          <span class="text-[#14b81a]">{t("how.title2")}</span>
        </h2>
        <p class="text-lg text-gray-600 mb-8 leading-relaxed">
          {t("how.subtitle")}
        </p>

        <ol class="space-y-6 mb-10">
          {
            steps.map((step) => (
              <li class="flex items-start gap-4">
                <div class="w-9 h-9 shrink-0 rounded-full bg-[#14b81a] text-[#082109] font-bold flex items-center justify-center">
                  {step.n}
                </div>
                <div>
                  <h3 class="font-bold text-[#082109] mb-1">{step.title}</h3>
                  <p class="text-gray-600 text-sm leading-relaxed">
                    {step.desc}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>

        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-[#14b81a] text-[#082109] font-bold px-8 py-4 rounded-2xl hover:bg-[#14b81a]/90 transition-all shadow-lg hover:shadow-xl"
        >
          {t("how.cta")}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
              points="12 5 19 12 12 19"></polyline></svg
          >
        </a>
      </div>

      <div class="flex-1 relative animate-fade-in-right delay-200 w-full">
        <ResultsPreview lang={lang} />

        <!-- Decoration -->
        <div
          class="absolute -z-10 -bottom-10 -right-10 w-64 h-64 bg-[#14b81a]/10 rounded-full blur-3xl"
        >
        </div>
        <div
          class="absolute -z-10 -top-10 -left-10 w-48 h-48 bg-[#14b81a]/5 rounded-full blur-2xl"
        >
        </div>
      </div>
    </div>
  </div>
</section>
