---
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";
import { whatsappUrl } from "../config/contact";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const whatsappHref = whatsappUrl(t("cta.whatsappMessage"));
---

<section id="contacto" class="py-24 bg-[#082109] relative overflow-hidden">
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(70% 80%, rgba(0, 204, 7, 0.08) 0%, transparent 70%);"
  >
  </div><div
    class="max-w-2xl mx-auto px-5 text-center relative z-10 animate-fade-in-up"
  >
    <h2 class="text-4xl sm:text-5xl font-bold text-white mb-5 leading-tight">
      {t("cta.title1")}
      <span class="text-[#1ec924]">{t("cta.title2")}</span>
    </h2><p class="text-white/60 text-lg mb-10">
      {t("cta.subtitle")}
    </p><div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-3 bg-[#1ec924] text-[#082109] font-bold px-8 py-4 rounded-2xl hover:brightness-110 transition-all shadow-xl shadow-[#1ec924]/20 hover:-translate-y-0.5 active:translate-y-0 animate-pulse-brand"
      >
        {t("cta.button")}
      </a>
    </div><p class="text-white/75 text-sm mt-8">
      {t("cta.byGadmin")}
      <a
        href="https://gadmin.app"
        target="_blank"
        class="text-white hover:text-[#1ec924] transition-colors">Gadmin</a
      >
    </p>
  </div>
</section>

<style>
  @keyframes pulse-brand {
    0% {
      box-shadow: 0 0 0 0 rgba(0, 204, 7, 0.4);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(0, 204, 7, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(0, 204, 7, 0);
    }
  }
  .animate-pulse-brand {
    animation: pulse-brand 2s infinite;
  }
</style>
