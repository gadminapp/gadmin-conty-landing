---
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const faqs = [
  { question: t("faq.1.q"), answer: t("faq.1.a") },
  { question: t("faq.2.q"), answer: t("faq.2.a") },
  { question: t("faq.3.q"), answer: t("faq.3.a") },
  { question: t("faq.4.q"), answer: t("faq.4.a") },
  { question: t("faq.5.q"), answer: t("faq.5.a") },
  { question: t("faq.6.q"), answer: t("faq.6.a") },
  { question: t("faq.7.q"), answer: t("faq.7.a") },
];
---

<section id="faq" class="py-24 bg-white">
  <div class="max-w-3xl mx-auto px-5">
    <div class="text-center mb-14 animate-fade-in-up">
      <span
        class="inline-block text-[#14b81a] text-sm font-semibold uppercase tracking-widest mb-3"
        >{t("faq.badge")}</span
      >
      <h2 class="text-3xl sm:text-4xl font-bold text-[#082109]">
        {t("faq.title")}
      </h2>
    </div>

    <div class="space-y-3">
      {
        faqs.map((faq, index) => (
          <div
            class="faq-item border border-gray-100 rounded-2xl overflow-hidden hover:border-[#14b81a]/30 transition-colors animate-fade-in-up"
            style={`animation-delay: ${index * 100}ms`}
          >
            <button
              class="faq-button w-full flex items-center justify-between px-6 py-4 text-left focus:outline-none"
              aria-expanded="false"
            >
              <span class="font-semibold text-[#082109] text-sm pr-4">
                {faq.question}
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-chevron-down text-[#14b81a] shrink-0 transition-transform duration-300"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </button>

            <div class="faq-answer max-h-0 overflow-hidden transition-all duration-300 ease-in-out bg-gray-50/50">
              <div class="px-6 pb-4 text-sm text-gray-600 leading-relaxed">
                {faq.answer}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  function setupFaq() {
    const faqItems = document.querySelectorAll(".faq-item");

    faqItems.forEach((item) => {
      const button = item.querySelector(".faq-button");
      const answer = item.querySelector(".faq-answer");
      const icon = item.querySelector("svg");

      button?.addEventListener("click", () => {
        const isOpen = button.getAttribute("aria-expanded") === "true";

        if (isOpen) {
          button.setAttribute("aria-expanded", "false");
          (answer as HTMLElement).style.maxHeight = "0";
          icon?.classList.remove("rotate-90");
        } else {
          button.setAttribute("aria-expanded", "true");
          (answer as HTMLElement).style.maxHeight = answer?.scrollHeight + "px";
          icon?.classList.add("rotate-90");
        }
      });
    });
  }

  setupFaq();
</script>

<style>
  .rotate-90 {
    transform: rotate(-90deg);
  }
</style>
