---
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
import { getPlayStoreUrl } from "../config/playStore";

const storeUrl = getPlayStoreUrl();

const freeFeat = [
  t("pricing.free.feat1"),
  t("pricing.free.feat2"),
  t("pricing.free.feat3"),
  t("pricing.free.feat4"),
  t("pricing.free.feat5"),
  t("pricing.free.feat6"),
  t("pricing.free.feat7"),
  t("pricing.free.feat8"),
];
---

<section id="precios" class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-5">
    <div class="text-center mb-12 animate-fade-in-up">
      <span
        class="inline-block text-[#14b81a] text-sm font-semibold uppercase tracking-widest mb-3"
        >{t("pricing.badge")}</span
      >
      <h2 class="text-3xl sm:text-4xl font-bold text-[#082109] mb-4">
        {t("pricing.title1")}
        <span class="text-[#14b81a]">{t("pricing.title2")}</span>
      </h2>

      <!-- Billing toggle -->
      <div class="flex justify-center mt-8 animate-fade-in-up">
        <div
          class="inline-flex items-center gap-3 bg-[#082109]/5 rounded-full p-1.5 shadow-sm border border-[#082109]/10"
        >
          <button
            id="btn-mensual"
            class="px-5 py-2 rounded-full text-sm font-semibold transition-all text-[#082109]/60 hover:text-[#082109]"
          >
            {t("pricing.billing.monthly")}
          </button>
          <button
            id="btn-anual"
            class="px-5 py-2 rounded-full text-sm font-semibold transition-all flex items-center gap-1.5 bg-white text-[#082109] shadow-sm"
          >
            {t("pricing.billing.yearly")}
            <span
              class="bg-[#1ec924] text-[#082109] text-[10px] px-1.5 py-0.5 rounded-full font-bold"
              >-17%</span
            >
          </button>
        </div>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <!-- Free Plan -->
      <div class="animate-fade-in-up delay-100">
        <div
          class="relative bg-white border-2 border-gray-200 rounded-3xl p-8 h-full flex flex-col"
        >
          <div class="flex items-center gap-2 mb-6">
            <div
              class="w-9 h-9 rounded-xl bg-gray-100 flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-[#08210990]"
                ><path d="M12 7v14"></path><path
                  d="M20 11v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8"></path><path
                  d="M7.5 7a1 1 0 0 1 0-5A4.8 8 0 0 1 12 7a4.8 8 0 0 1 4.5-5 1 1 0 0 1 0 5"
                ></path><rect x="3" y="7" width="18" height="4" rx="1"
                ></rect></svg
              >
            </div>
            <span class="text-[#082109] font-bold text-lg"
              >{t("pricing.free.name")}</span
            >
          </div>

          <div class="mb-2">
            <div class="flex items-end gap-2">
              <span class="text-5xl font-bold text-[#082109]"
                >{t("pricing.free.price")}</span
              >
              <span class="text-gray-400 mb-2 text-sm"
                >{t("pricing.free.period")}</span
              >
            </div>
            <p class="text-gray-500 text-sm mt-1">{t("pricing.free.desc")}</p>
          </div>

          <ul class="space-y-3 my-8 flex-1">
            {
              freeFeat.map((feat) => (
                <li class="flex items-center gap-3">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="text-[#14b81a] shrink-0"
                  >
                    <>
                      <path d="M21.801 10A10 10 0 1 1 17 3.335" />
                      <path d="m9 11 3 3L22 4" />
                    </>
                  </svg>
                  <span class="text-[#082109]/80 text-sm">{feat}</span>
                </li>
              ))
            }
          </ul>

          <a
            href={storeUrl}
            data-play-store-link
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full text-center bg-[#082109] text-white font-bold py-4 rounded-2xl hover:bg-[#082109]/90 transition-all"
          >
            {t("pricing.free.cta")}
          </a>
          <div
            class="text-gray-500 text-xs flex items-center justify-center gap-1.5 mt-3 opacity-0"
          >
            <span>&nbsp;</span>
          </div>
        </div>
      </div>

      <!-- Lite Plan -->
      <div class="animate-fade-in-up delay-150">
        <div
          class="relative bg-white border-2 border-gray-200 rounded-3xl p-8 h-full flex flex-col shadow-lg shadow-[#14b81a]/10"
        >
          <div class="flex items-center gap-2 mb-6">
            <div
              class="w-9 h-9 rounded-xl bg-[#14b81a]/10 flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-[#14b81a]"
                ><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg
              >
            </div>
            <span class="text-[#082109] font-bold text-lg"
              >{t("pricing.lite.name")}</span
            >
          </div>

          <div class="mb-2">
            <div class="flex items-end gap-2">
              <span id="lite-price" class="text-5xl font-bold text-[#082109]"
                >{t("pricing.lite.yearly.price")}</span
              >
              <span id="lite-period" class="text-gray-400 mb-2 text-sm"
                >{t("pricing.lite.yearly.period")}</span
              >
            </div>
            <p id="lite-desc" class="text-gray-500 text-sm mt-1">
              <span class="text-[#14b81a] font-medium"
                >{t("pricing.lite.yearly.equiv")}</span
              ><br />
              <span class="text-gray-500 text-sm"
                >{t("pricing.lite.yearly.installments")}</span
              >
            </p>
          </div>

          <p
            class="text-[#082109]/40 text-xs uppercase tracking-wider font-semibold mb-3 mt-6"
          >
            {t("pricing.lite.plus")}
          </p>

          <ul class="space-y-3 mb-8 flex-1">
            {
              [t("pricing.lite.feat1"), t("pricing.lite.feat2")].map((feat) => (
                <li class="flex items-center gap-3">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="text-[#14b81a] shrink-0"
                  >
                    <>
                      <path d="M21.801 10A10 10 0 1 1 17 3.335" />
                      <path d="m9 11 3 3L22 4" />
                    </>
                  </svg>
                  <span class="text-[#082109]/80 text-sm">{feat}</span>
                </li>
              ))
            }
          </ul>

          <a
            href={storeUrl}
            data-play-store-link
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full text-center bg-[#14b81a] text-white font-bold py-4 rounded-2xl hover:brightness-105 transition-all shadow-md shadow-[#14b81a]/20"
          >
            {t("pricing.lite.cta")}
          </a>

          <div
            id="lite-installments"
            class="text-gray-500 text-xs flex items-center justify-center gap-1.5 mt-3 transition-opacity duration-200"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-info shrink-0"
              ><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"
              ></path><path d="M12 8h.01"></path></svg
            >
            <p
              set:html={`${t("pricing.lite.installments.label")} <strong>4</strong> ${t("pricing.lite.installments.of")}`}
            />
          </div>
        </div>
      </div>

      <!-- Premium Plan -->
      <div class="animate-fade-in-up delay-200">
        <div
          class="relative bg-[#082109] rounded-3xl p-8 shadow-2xl overflow-hidden h-full flex flex-col"
        >
          <div
            class="absolute top-5 right-5 bg-[#1ec924] text-[#082109] text-xs font-bold px-3 py-1 rounded-full z-20"
          >
            {t("pricing.premium.badge")}
          </div>
          <div
            class="absolute inset-0 pointer-events-none"
            style="background: radial-gradient(80% 60% at 50% 0%, rgba(0, 204, 7, 0.15) 0%, transparent 70%);"
          >
          </div>

          <div class="relative z-10 flex flex-col h-full">
            <div class="flex items-center gap-2 mb-6">
              <div
                class="w-9 h-9 rounded-xl bg-[#1ec924] flex items-center justify-center"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-[#082109]"
                  ><path d="M10.5 3 8 9l4 13 4-13-2.5-6"></path><path
                    d="M17 3a2 2 0 0 1 1.6.8l3 4a2 2 0 0 1 .013 2.382l-7.99 10.986a2 2 0 0 1-3.247 0l-7.99-10.986A2 2 0 0 1 2.4 7.8l2.998-3.997A2 2 0 0 1 7 3z"
                  ></path><path d="M2 9h20"></path></svg
                >
              </div>
              <span class="text-white font-bold text-lg"
                >{t("pricing.premium.name")}</span
              >
            </div>

            <div class="mb-2">
              <div class="flex items-end gap-2">
                <span id="premium-price" class="text-5xl font-bold text-white"
                  >{t("pricing.premium.yearly.price")}</span
                >
                <span id="premium-period" class="text-white/75 mb-2 text-sm"
                  >{t("pricing.premium.yearly.period")}</span
                >
              </div>
              <p id="premium-desc" class="text-white/75 text-sm mt-1">
                <span class="text-[#14b81a] font-medium"
                  >{t("pricing.premium.yearly.equiv")}</span
                ><br />
                <span class="text-white/75 text-sm"
                  >{t("pricing.premium.yearly.installments")}</span
                >
              </p>
            </div>

            <p
              class="text-white/50 text-xs uppercase tracking-wider font-semibold mb-3 mt-6"
            >
              {t("pricing.premium.plus")}
            </p>

            <ul class="space-y-3 mb-8 flex-1">
              <li class="flex items-start gap-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-[#1ec924] shrink-0 mt-0.5"
                  ><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path
                    d="m9 11 3 3L22 4"></path></svg
                >
                <span class="text-white/80 text-sm">
                  {t("pricing.premium.feat1")}<br />
                  <small class="text-white/60 text-[11px] leading-tight"
                    >({t("pricing.premium.feat1.sub")})</small
                  >
                </span>
              </li>
              {
                [
                  t("pricing.premium.feat2"),
                  t("pricing.premium.feat3"),
                  t("pricing.premium.feat4"),
                  t("pricing.premium.feat5"),
                ].map((feat) => (
                  <li class="flex items-start gap-3">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="text-[#1ec924] shrink-0 mt-0.5"
                    >
                      <>
                        <path d="M21.801 10A10 10 0 1 1 17 3.335" />
                        <path d="m9 11 3 3L22 4" />
                      </>
                    </svg>
                    <span class="text-white/80 text-sm">{feat}</span>
                  </li>
                ))
              }
            </ul>

            <a
              href={storeUrl}
              data-play-store-link
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full text-center bg-[#1ec924] text-[#082109] font-bold py-4 rounded-2xl hover:brightness-110 transition-all shadow-lg shadow-[#1ec924]/20"
            >
              {t("pricing.premium.cta")}
            </a>

            <div
              id="premium-installments"
              class="text-white/75 text-xs flex items-center justify-center gap-1.5 mt-3 transition-opacity duration-200"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-info shrink-0"
                ><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"
                ></path><path d="M12 8h.01"></path></svg
              >
              <p
                set:html={`${t("pricing.premium.installments.label")} <strong>4</strong> ${t("pricing.premium.installments.of")}`}
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <div
      class="mt-8 bg-[#14b81a]/5 border border-[#14b81a]/10 rounded-2xl p-4 text-center max-w-4xl mx-auto"
    >
      <p class="text-[#082109]/70 text-sm">{t("pricing.footer")}</p>
    </div>
  </div>
</section>

<script>
  // Grab translated strings injected via data attributes on the section
  const section = document.getElementById("precios");
  const lang = document.documentElement.lang || "en";
  const isEs = lang === "es";

  const btnMensual = document.getElementById("btn-mensual");
  const btnAnual = document.getElementById("btn-anual");
  const litePrice = document.getElementById("lite-price");
  const litePeriod = document.getElementById("lite-period");
  const liteDesc = document.getElementById("lite-desc");
  const liteInstallments = document.getElementById("lite-installments");
  const premiumPrice = document.getElementById("premium-price");
  const premiumPeriod = document.getElementById("premium-period");
  const premiumDesc = document.getElementById("premium-desc");
  const premiumInstallments = document.getElementById("premium-installments");

  const strings = isEs
    ? {
        liteYearlyPrice: "$49.99",
        liteYearlyPeriod: "/ año",
        liteYearlyEquiv: "Equivale a $4.17/mes",
        liteYearlyInstall: "o 4 cuotas de $12.49 sin interés",
        liteMonthlyPrice: "$4.99",
        liteMonthlyPeriod: "/ mes",
        liteMonthlySave: "O paga anualmente y ahorra 2 meses",
        liteInstallText:
          "Paga a <strong>4 cuotas</strong> sin intereses de $12.49",
        premiumYearlyPrice: "$199.99",
        premiumYearlyPeriod: "/ año",
        premiumYearlyEquiv: "Equivale a $16.67/mes",
        premiumYearlyInstall: "o 4 cuotas de $49.99 sin interés",
        premiumMonthlyPrice: "$19.99",
        premiumMonthlyPeriod: "/ mes",
        premiumMonthlySave: "O paga anualmente y ahorra 2 meses",
        premiumInstallText:
          "Paga a <strong>4 cuotas</strong> sin intereses de $49.99",
      }
    : {
        liteYearlyPrice: "$49.99",
        liteYearlyPeriod: "/ year",
        liteYearlyEquiv: "Equals $4.17/month",
        liteYearlyInstall: "or 4 installments of $12.49 interest-free",
        liteMonthlyPrice: "$4.99",
        liteMonthlyPeriod: "/ month",
        liteMonthlySave: "Or pay annually and save 2 months",
        liteInstallText:
          "Pay in <strong>4</strong> installments interest-free of $12.49",
        premiumYearlyPrice: "$199.99",
        premiumYearlyPeriod: "/ year",
        premiumYearlyEquiv: "Equals $16.67/month",
        premiumYearlyInstall: "or 4 installments of $49.99 interest-free",
        premiumMonthlyPrice: "$19.99",
        premiumMonthlyPeriod: "/ month",
        premiumMonthlySave: "Or pay annually and save 2 months",
        premiumInstallText:
          "Pay in <strong>4</strong> installments interest-free of $49.99",
      };

  function setPricing(mode: "yearly" | "monthly") {
    if (!btnAnual || !btnMensual) return;

    const yearly = mode === "yearly";

    btnAnual.classList.toggle("bg-white", yearly);
    btnAnual.classList.toggle("text-[#082109]", yearly);
    btnAnual.classList.toggle("shadow-sm", yearly);
    btnAnual.classList.toggle("text-[#082109]/60", !yearly);
    btnMensual.classList.toggle("bg-white", !yearly);
    btnMensual.classList.toggle("text-[#082109]", !yearly);
    btnMensual.classList.toggle("shadow-sm", !yearly);
    btnMensual.classList.toggle("text-[#082109]/60", yearly);

    if (litePrice)
      litePrice.textContent = yearly
        ? strings.liteYearlyPrice
        : strings.liteMonthlyPrice;
    if (litePeriod)
      litePeriod.textContent = yearly
        ? strings.liteYearlyPeriod
        : strings.liteMonthlyPeriod;
    if (liteDesc) {
      liteDesc.innerHTML = yearly
        ? `<span class="text-[#14b81a] font-medium">${strings.liteYearlyEquiv}</span><br/><span class="text-gray-500 text-sm">${strings.liteYearlyInstall}</span>`
        : strings.liteMonthlySave;
    }
    if (liteInstallments) liteInstallments.style.opacity = yearly ? "1" : "0";

    if (premiumPrice)
      premiumPrice.textContent = yearly
        ? strings.premiumYearlyPrice
        : strings.premiumMonthlyPrice;
    if (premiumPeriod)
      premiumPeriod.textContent = yearly
        ? strings.premiumYearlyPeriod
        : strings.premiumMonthlyPeriod;
    if (premiumDesc) {
      premiumDesc.innerHTML = yearly
        ? `<span class="text-[#14b81a] font-medium">${strings.premiumYearlyEquiv}</span><br/><span class="text-white/75 text-sm">${strings.premiumYearlyInstall}</span>`
        : strings.premiumMonthlySave;
    }
    if (premiumInstallments)
      premiumInstallments.style.opacity = yearly ? "1" : "0";
  }

  btnMensual?.addEventListener("click", () => setPricing("monthly"));
  btnAnual?.addEventListener("click", () => setPricing("yearly"));
</script>
