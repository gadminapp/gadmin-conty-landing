---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import WhatsAppAssistant from "../components/WhatsAppAssistant.astro";
import Features from "../components/Features.astro";
import Choice from "../components/Choice.astro";
import Comparison from "../components/Comparison.astro";
import FAQ from "../components/FAQ.astro";
import CTA from "../components/CTA.astro";

const lang = "en";
---

<Layout
  title="Conty - Your numbers, turned into decisions"
  description="Conty is the agency that turns your income, sales, expenses and restock into detailed strategic reports. Save the hours and the team you would otherwise hire."
  keywords="business analysis agency, strategic reports, sales analytics, expense control, sme, financial advisory, cash flow, venezuela"
  lang={lang}
>
  <Hero lang={lang} />
  <WhatsAppAssistant lang={lang} />
  <Features lang={lang} />
  <Choice lang={lang} />
  <Comparison lang={lang} />
  <FAQ lang={lang} />
  <CTA lang={lang} />
</Layout>

<!-- Browser language detection: redirect Spanish users to /es -->
<script>
  (function () {
    const hasChosen = sessionStorage.getItem("lang-chosen");
    if (hasChosen) return;

    const browserLang =
      navigator.language || (navigator as any).userLanguage || "";
    if (browserLang.toLowerCase().startsWith("es")) {
      sessionStorage.setItem("lang-chosen", "es");
      window.location.replace("/es" + window.location.search);
    } else {
      sessionStorage.setItem("lang-chosen", "en");
    }
  })();
</script>
