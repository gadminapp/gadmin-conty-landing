---
import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import WhatsAppAssistant from "../../components/WhatsAppAssistant.astro";
import Features from "../../components/Features.astro";
import Choice from "../../components/Choice.astro";
import Comparison from "../../components/Comparison.astro";
import FAQ from "../../components/FAQ.astro";
import CTA from "../../components/CTA.astro";

const lang = "es";
---

<Layout
  title="Conty - Tus números, convertidos en decisiones"
  description="Conty es la agencia que convierte tus ingresos, ventas, gastos y reposición en reportes estratégicos detallados. Te ahorra las horas y el equipo que tendrías que contratar."
  keywords="agencia de análisis de negocios, reportes estratégicos, analítica de ventas, control de gastos, pymes, asesoría financiera, flujo de caja, venezuela"
  lang={lang}
>
  <Hero lang={lang} />
  <WhatsAppAssistant lang={lang} />
  <Features lang={lang} />
  <Choice lang={lang} />
  <Comparison lang={lang} />
  <FAQ lang={lang} />
  <CTA lang={lang} />
</Layout>
