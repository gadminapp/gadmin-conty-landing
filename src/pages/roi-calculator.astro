---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import CTA from "../components/CTA.astro";
import { useTranslations } from "../i18n/utils";

const lang = "en" as const;
const t = useTranslations(lang);
---

<Layout
  title={t("roi.title")}
  description={t("roi.description")}
  keywords={t("roi.keywords")}
  lang={lang}
  robots="noindex, nofollow"
>
  <section
    class="flex items-center relative min-h-screen py-20 pt-24 overflow-hidden"
  >
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(80% 60% at 50% 0%, rgba(0, 204, 7, 0.08) 0%, transparent 70%);"
    >
    </div>
    <div
      class="absolute top-1/4 -right-20 w-96 h-96 bg-[#14b81a]/5 rounded-full blur-[120px] pointer-events-none"
    >
    </div>
    <div
      class="absolute bottom-1/4 -left-20 w-80 h-80 bg-[#14b81a]/4 rounded-full blur-[100px] pointer-events-none"
    >
    </div>

    <div class="max-w-6xl mx-auto px-5 relative z-10 w-full">
      <div class="animate-fade-in-up mb-14 max-w-2xl">
        <span
          class="inline-flex items-center gap-2 px-4 py-2 bg-[#14b81a]/10 text-[#14b81a] font-semibold text-sm rounded-full mb-6"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><line x1="12" y1="1" x2="12" y2="23"></line><path
              d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg
          >
          {t("roi.badge")}
        </span>
        <h1
          class="text-4xl sm:text-6xl font-bold text-[#082109] leading-tight mb-6"
        >
          {t("roi.h1a")}
          <span class="text-[#14b81a]">{t("roi.h1b")}</span>
        </h1>
        <p class="text-xl text-[#082109]/60 leading-relaxed max-w-lg">
          {t("roi.intro")}
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-10 items-start">
        <!-- Inputs -->
        <div class="animate-fade-in-up space-y-6">
          <p
            class="text-xs font-bold text-[#082109]/40 uppercase tracking-widest"
          >
            {t("roi.inputs.section")}
          </p>

          <!-- MRR Slider -->
          <div
            class="p-6 bg-white border border-[#082109]/5 rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.02)]"
          >
            <div class="flex items-center justify-between mb-3">
              <label
                for="mrr-slider"
                class="text-sm font-semibold text-[#082109]/70"
                >{t("roi.mrr.label")}</label
              >
              <span id="mrr-display" class="text-xl font-bold text-[#14b81a]"
                >$1,000</span
              >
            </div>
            <input
              id="mrr-slider"
              type="range"
              min="500"
              max="100000"
              step="500"
              value="1000"
              class="roi-slider w-full h-2 rounded-full appearance-none cursor-pointer"
            />
            <p class="text-xs text-[#082109]/40 mt-2">{t("roi.mrr.hint")}</p>
          </div>

          <!-- Your Capital -->
          <div
            class="p-6 bg-white border border-[#082109]/5 rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.02)]"
          >
            <label
              for="capital-input"
              class="block text-sm font-semibold text-[#082109]/70 mb-3"
              >{t("roi.capital.label")}</label
            >
            <div class="relative">
              <span
                class="absolute left-4 top-1/2 -translate-y-1/2 text-[#082109]/40 font-bold text-lg"
                >$</span
              >
              <input
                id="capital-input"
                type="number"
                min="0"
                step="100"
                value="500"
                placeholder={t("roi.capital.placeholder")}
                class="w-full pl-9 pr-5 py-4 bg-[#082109]/5 border-none rounded-2xl focus:ring-2 focus:ring-[#14b81a] transition-all outline-none text-[#082109] font-semibold text-lg placeholder:text-[#082109]/30"
              />
            </div>
          </div>

          <!-- Total Capital -->
          <div
            class="p-6 bg-white border border-[#082109]/5 rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.02)]"
          >
            <label
              for="total-input"
              class="block text-sm font-semibold text-[#082109]/70 mb-3"
              >{t("roi.total.label")}</label
            >
            <div class="relative">
              <span
                class="absolute left-4 top-1/2 -translate-y-1/2 text-[#082109]/40 font-bold text-lg"
                >$</span
              >
              <input
                id="total-input"
                type="number"
                min="1"
                step="100"
                value="10000"
                placeholder={t("roi.total.placeholder")}
                class="w-full pl-9 pr-5 py-4 bg-[#082109]/5 border-none rounded-2xl focus:ring-2 focus:ring-[#14b81a] transition-all outline-none text-[#082109] font-semibold text-lg placeholder:text-[#082109]/30"
              />
            </div>
          </div>

          <!-- ROI Multiplier -->
          <div
            class="p-6 bg-white border border-[#082109]/5 rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.02)]"
          >
            <label
              for="roi-input"
              class="block text-sm font-semibold text-[#082109]/70 mb-1"
              >{t("roi.roi.label")}</label
            >
            <p class="text-xs text-[#082109]/40 mb-3">{t("roi.roi.hint")}</p>
            <div class="relative">
              <input
                id="roi-input"
                type="number"
                min="0.5"
                step="0.5"
                value="2"
                class="w-full px-5 py-4 bg-[#082109]/5 border-none rounded-2xl focus:ring-2 focus:ring-[#14b81a] transition-all outline-none text-[#082109] font-semibold text-lg"
              />
              <span
                class="absolute right-5 top-1/2 -translate-y-1/2 text-[#082109]/40 font-bold"
                >x</span
              >
            </div>
          </div>

          <!-- How calculated -->
          <div
            class="p-6 bg-[#14b81a]/5 border border-[#14b81a]/10 rounded-3xl"
          >
            <p
              class="text-sm font-bold text-[#082109]/80 mb-3 flex items-center gap-2"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="10"></circle><line
                  x1="12"
                  y1="16"
                  x2="12"
                  y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"
                ></line></svg
              >
              {t("roi.how.title")}
            </p>
            <ul class="space-y-2">
              <li class="text-xs text-[#082109]/60 flex items-start gap-2">
                <span class="text-[#14b81a] font-bold shrink-0">①</span>{
                  t("roi.how.1")
                }
              </li>
              <li class="text-xs text-[#082109]/60 flex items-start gap-2">
                <span class="text-[#14b81a] font-bold shrink-0">②</span>{
                  t("roi.how.2")
                }
              </li>
              <li class="text-xs text-[#082109]/60 flex items-start gap-2">
                <span class="text-[#14b81a] font-bold shrink-0">③</span>{
                  t("roi.how.3")
                }
              </li>
              <li class="text-xs text-[#082109]/60 flex items-start gap-2">
                <span class="text-[#14b81a] font-bold shrink-0">④</span>{
                  t("roi.how.4")
                }
              </li>
            </ul>
          </div>
        </div>

        <!-- Results -->
        <div class="animate-fade-in-up delay-100 space-y-6">
          <p
            class="text-xs font-bold text-[#082109]/40 uppercase tracking-widest"
          >
            {t("roi.results.title")}
          </p>

          <div
            class="p-8 sm:p-10 bg-white rounded-[2.5rem] shadow-[0_20px_50px_rgba(8,33,9,0.06)] border border-[#082109]/5 relative overflow-hidden"
          >
            <div
              class="absolute top-0 right-0 w-40 h-40 bg-[#14b81a]/5 rounded-full blur-[60px] pointer-events-none"
            >
            </div>

            <div class="mb-8 text-center">
              <p
                class="text-sm font-semibold text-[#082109]/50 uppercase tracking-wider mb-2"
              >
                {t("roi.results.monthly")}
              </p>
              <div
                id="monthly-result"
                class="text-6xl sm:text-7xl font-black text-[#14b81a] tabular-nums transition-all duration-300"
              >
                $0.00
              </div>
              <p class="text-sm text-[#082109]/40 mt-1">
                {t("roi.results.net")}: <span
                  id="net-mrr-display"
                  class="font-semibold text-[#082109]/60">$0</span>
              </p>
            </div>

            <div class="space-y-4">
              <div
                class="flex items-center justify-between p-4 bg-[#082109]/3 rounded-2xl"
              >
                <div class="flex items-center gap-3">
                  <div
                    class="w-9 h-9 bg-[#14b81a]/10 rounded-xl flex items-center justify-center"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#14b81a"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                      ></path></svg
                    >
                  </div>
                  <span class="text-sm font-medium text-[#082109]/70"
                    >{t("roi.results.share")}</span
                  >
                </div>
                <span id="share-result" class="text-lg font-bold text-[#082109]"
                  >0.00%</span
                >
              </div>

              <div
                class="flex items-center justify-between p-4 bg-[#082109]/3 rounded-2xl"
              >
                <div class="flex items-center gap-3">
                  <div
                    class="w-9 h-9 bg-[#14b81a]/10 rounded-xl flex items-center justify-center"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#14b81a"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"
                      ></rect><line x1="16" y1="2" x2="16" y2="6"></line><line
                        x1="8"
                        y1="2"
                        x2="8"
                        y2="6"></line><line x1="3" y1="10" x2="21" y2="10"
                      ></line></svg
                    >
                  </div>
                  <span class="text-sm font-medium text-[#082109]/70"
                    >{t("roi.results.annual")}</span
                  >
                </div>
                <span
                  id="annual-result"
                  class="text-lg font-bold text-[#082109]">$0.00</span
                >
              </div>
              <div
                id="annual-exceeds-hint"
                class="hidden flex items-start gap-2 px-3 py-2 bg-emerald-50 border border-emerald-200/70 rounded-xl"
              >
                <svg class="shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                <p class="text-xs text-emerald-700 leading-relaxed">{t("roi.results.annual.exceeds")}</p>
              </div>

              <div
                class="flex items-center justify-between p-4 bg-[#082109]/3 rounded-2xl"
              >
                <div class="flex items-center gap-3">
                  <div
                    class="w-9 h-9 bg-[#14b81a]/10 rounded-xl flex items-center justify-center"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#14b81a"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><circle cx="12" cy="12" r="10"></circle><polyline
                        points="12 6 12 12 16 14"></polyline></svg
                    >
                  </div>
                  <span class="text-sm font-medium text-[#082109]/70"
                    >{t("roi.results.breakeven")}</span
                  >
                </div>
                <span
                  id="breakeven-result"
                  data-months={t("roi.results.months")}
                  data-na={t("roi.results.never")}
                  class="text-lg font-bold text-[#082109]">—</span
                >
              </div>

              <div
                class="flex items-center justify-between p-4 bg-[#14b81a]/8 border border-[#14b81a]/20 rounded-2xl"
                style="background:rgba(20,184,26,0.06)"
              >
                <div class="flex items-center gap-3">
                  <div
                    class="w-9 h-9 bg-[#14b81a]/20 rounded-xl flex items-center justify-center"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#14b81a"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"
                      ></polyline><polyline points="17 6 23 6 23 12"
                      ></polyline></svg
                    >
                  </div>
                  <span class="text-sm font-semibold text-[#082109]/80"
                    >{t("roi.results.total")}</span
                  >
                </div>
                <span id="total-result" class="text-lg font-bold text-[#14b81a]"
                  >$0.00</span
                >
              </div>
            </div>
          </div>

          <!-- Disclaimer -->
          <div class="p-5 bg-amber-50 border border-amber-200/60 rounded-2xl">
            <p
              class="text-xs font-bold text-amber-700 mb-1 flex items-center gap-1.5"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
                ></path><line x1="12" y1="9" x2="12" y2="13"></line><line
                  x1="12"
                  y1="17"
                  x2="12.01"
                  y2="17"></line></svg
              >
              {t("roi.disclaimer.title")}
            </p>
            <p class="text-xs text-amber-700/80 leading-relaxed">
              {t("roi.disclaimer.text")}
            </p>
          </div>

          <!-- CTA -->
          <div
            class="group p-6 bg-white border border-[#082109]/5 rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.02)] hover:shadow-[0_8px_30px_rgba(0,204,7,0.1)] transition-all duration-300"
          >
            <p class="font-bold text-[#082109] mb-1">{t("roi.cta.title")}</p>
            <p class="text-sm text-[#082109]/60 mb-4">{t("roi.cta.text")}</p>
            <a
              href="/contact"
              class="inline-flex items-center gap-2 py-3 px-6 bg-[#14b81a] text-white font-bold rounded-2xl shadow-lg shadow-[#14b81a]/20 hover:bg-[#00b306] hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 text-sm"
            >
              {t("roi.cta.button")}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
                  points="12 5 19 12 12 19"></polyline></svg
              >
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTA lang={lang} />
</Layout>

<style>
  .roi-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #14b81a;
    box-shadow:
      0 0 0 4px rgba(20, 184, 26, 0.2),
      0 2px 8px rgba(20, 184, 26, 0.4);
    cursor: pointer;
    transition: box-shadow 0.2s;
  }
  .roi-slider::-webkit-slider-thumb:hover {
    box-shadow:
      0 0 0 6px rgba(20, 184, 26, 0.25),
      0 2px 12px rgba(20, 184, 26, 0.5);
  }
  .roi-slider::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #14b81a;
    border: none;
    box-shadow: 0 0 0 4px rgba(20, 184, 26, 0.2);
    cursor: pointer;
  }
</style>

<script>
  function fmt(n: number) {
    return n.toLocaleString("en-US", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });
  }

  function updateSliderProgress(slider: HTMLInputElement) {
    const min = parseFloat(slider.min);
    const max = parseFloat(slider.max);
    const val = parseFloat(slider.value);
    const pct = ((val - min) / (max - min)) * 100;
    slider.style.background = `linear-gradient(to right, #14b81a 0%, #14b81a ${pct}%, rgba(8,33,9,0.08) ${pct}%, rgba(8,33,9,0.08) 100%)`;
  }

  function calculate() {
    const mrr =
      parseFloat(
        (document.getElementById("mrr-slider") as HTMLInputElement).value,
      ) || 0;
    const capital =
      parseFloat(
        (document.getElementById("capital-input") as HTMLInputElement).value,
      ) || 0;
    const total =
      parseFloat(
        (document.getElementById("total-input") as HTMLInputElement).value,
      ) || 1;
    const roi =
      parseFloat(
        (document.getElementById("roi-input") as HTMLInputElement).value,
      ) || 2;

    const share = total > 0 ? (capital / total) * 100 : 0;
    const netMrr = mrr * 0.7;
    const monthly = netMrr * (share / 100);
    const annual = monthly * 12;
    const totalReturn = capital * roi;
    const breakeven = monthly > 0 ? Math.ceil(capital / monthly) : null;

    (document.getElementById("mrr-display") as HTMLElement).textContent =
      "$" + mrr.toLocaleString("en-US");
    (document.getElementById("monthly-result") as HTMLElement).textContent =
      "$" + fmt(monthly);
    (document.getElementById("net-mrr-display") as HTMLElement).textContent =
      "$" + fmt(netMrr);
    (document.getElementById("share-result") as HTMLElement).textContent =
      share.toLocaleString("en-US", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 4,
      }) + "%";
    (document.getElementById("annual-result") as HTMLElement).textContent =
      "$" + fmt(annual);
    (document.getElementById("total-result") as HTMLElement).textContent =
      "$" + fmt(totalReturn);

    // Show hint when annual earnings exceed the total ROI return
    const annualHint = document.getElementById("annual-exceeds-hint") as HTMLElement;
    if (annual > totalReturn && totalReturn > 0) {
      annualHint.classList.remove("hidden");
    } else {
      annualHint.classList.add("hidden");
    }

    const breakevenEl = document.getElementById(
      "breakeven-result",
    ) as HTMLElement;
    if (breakeven !== null) {
      breakevenEl.textContent =
        breakeven + " " + (breakevenEl.dataset.months || "months");
    } else {
      breakevenEl.textContent = breakevenEl.dataset.na || "N/A";
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    const slider = document.getElementById("mrr-slider") as HTMLInputElement;
    updateSliderProgress(slider);
    slider.addEventListener("input", () => {
      updateSliderProgress(slider);
      calculate();
    });
    document
      .getElementById("capital-input")
      ?.addEventListener("input", calculate);
    document
      .getElementById("total-input")
      ?.addEventListener("input", calculate);
    document.getElementById("roi-input")?.addEventListener("input", calculate);
    calculate();
  });
</script>
